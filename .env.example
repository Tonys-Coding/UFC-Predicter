# Optional: public market data works without credentials.
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=
# Password for an encrypted RSA PEM file; leave empty for an unencrypted key.
KALSHI_PASSPHRASE=
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
UFCSTATS_BASE_URL=http://ufcstats.com
UFC_SCRAPE_DELAY_SECONDS=1.5
APP_TIMEZONE=America/Chicago
LOG_LEVEL=INFO
# Defaults are beside the source files, independent of the working directory.
# UFC_DB_PATH=/absolute/path/ufc_analytics.db
# UFC_MODEL_PATH=/absolute/path/ufc_brain.pkl
